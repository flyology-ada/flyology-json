with "flyology_bench";

project Flyology_JSON_Writer_Benchmarks is

   type Tuning_Kind is ("portable", "native");
   Tuning : Tuning_Kind :=
     external ("FLYOLOGY_JSON_BENCH_TUNING", "portable");
   Native_CPU_Switch :=
     external ("FLYOLOGY_JSON_BENCH_NATIVE_SWITCH", "-march=native");
   Ada_Tuning_Switches := ();

   case Tuning is
      when "portable" =>
         Ada_Tuning_Switches := ();
      when "native" =>
         Ada_Tuning_Switches := (Native_CPU_Switch);
   end case;

   for Source_Dirs use ("../src", "src");
   for Main use ("flyology_json-writer_benchmark.adb");
   for Object_Dir use "writer_obj/release/" & Tuning;
   for Exec_Dir use "writer_bin/" & Tuning;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O3", "-gnat2022", "-gnatp", "-gnatn", "-gnatwa", "-gnatwJ", "-gnatyM110") &
        Ada_Tuning_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Kind ("Ada") use "spaces";
      for Indentation_Continuation ("Ada") use "2";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;

end Flyology_JSON_Writer_Benchmarks;
