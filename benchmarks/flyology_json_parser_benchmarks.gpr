with "flyology_bench";
with "config/flyology_json_parser_benchmarks_config.gpr";

project Flyology_JSON_Parser_Benchmarks is

   for Source_Dirs use ("../src", "src");
   for Main use ("flyology_json-parser_benchmark.adb");
   for Object_Dir use
     "obj/" & Flyology_JSON_Parser_Benchmarks_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_JSON_Parser_Benchmarks_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnatwa", "-gnatwJ", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Kind ("Ada") use "spaces";
      for Indentation_Continuation ("Ada") use "2";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;

end Flyology_JSON_Parser_Benchmarks;
