with "flyology_bench";
with "../../config/flyology_json_parser_benchmarks_config.gpr";

project Rust_Writer_Benchmarks is
   type Tuning_Kind is ("portable", "native");
   Tuning : Tuning_Kind := external ("FLYOLOGY_JSON_BENCH_TUNING", "portable");
   Rust_Adapter_Dir := external ("RUST_ADAPTER_DIR", "target/" & Tuning & "/release");
   System_Libraries := external_as_list ("FLYOLOGY_JSON_BENCH_SYSTEM_LIBRARIES", " ");
   Native_CPU_Switch := external ("FLYOLOGY_JSON_BENCH_NATIVE_SWITCH", "-march=native");
   Native_Switches := ();
   case Tuning is
      when "portable" => Native_Switches := ();
      when "native" => Native_Switches := (Native_CPU_Switch);
   end case;

   for Languages use ("Ada");
   for Source_Dirs use ("../../../src", "ada", "bench");
   for Main use ("flyology_json-benchmark_rust_writer_benchmark.adb");
   for Object_Dir use "writer_obj/" & Tuning;
   for Exec_Dir use "writer_bin/" & Tuning;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_JSON_Parser_Benchmarks_Config.Ada_Compiler_Switches &
        ("-gnat2022", "-gnatwa", "-gnatwJ", "-gnatyM110") & Native_Switches;
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
   package Linker is
      for Switches ("flyology_json-benchmark_rust_writer_benchmark.adb") use
        (Rust_Adapter_Dir & "/libflyology_json_rust_bench_adapters.a") & System_Libraries;
   end Linker;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Kind ("Ada") use "spaces";
      for Indentation_Continuation ("Ada") use "2";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;

end Rust_Writer_Benchmarks;
