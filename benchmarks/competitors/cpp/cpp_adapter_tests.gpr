project CPP_Adapter_Tests is

   type Tuning_Kind is ("portable", "native");
   Tuning : Tuning_Kind := external ("FLYOLOGY_JSON_BENCH_TUNING", "portable");
   Native_CPU_Switch :=
     external ("FLYOLOGY_JSON_BENCH_NATIVE_SWITCH", "-march=native");
   CXX_Tuning_Switches := ();

   case Tuning is
      when "portable" =>
         CXX_Tuning_Switches := ("-O3");
      when "native" =>
         CXX_Tuning_Switches := ("-O3", Native_CPU_Switch);
   end case;

   for Languages use ("Ada", "C++");
   for Source_Dirs use
     ("../../../src",
      "ada",
      "tests",
      "simdjson/ada",
      "simdjson/src",
      "simdjson/upstream",
      "rapidjson/ada",
      "rapidjson/src");
   for Main use ("flyology_json-benchmark_cpp_tests.adb");
   for Object_Dir use "obj/" & Tuning;
   for Exec_Dir use "bin/" & Tuning;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwJ", "-gnatyM110", "-O2");
      for Default_Switches ("C++") use
        ("-std=c++17",
         "-Wall",
         "-Wextra",
         "-Werror",
         "-I" & Project'Project_Dir & "include",
         "-I" & Project'Project_Dir & "simdjson/upstream",
         "-I" & Project'Project_Dir & "rapidjson/upstream/include") & CXX_Tuning_Switches;
      for Switches ("simdjson.cpp") use
        ("-std=c++17", "-DNDEBUG", "-I" & Project'Project_Dir & "simdjson/upstream")
        & CXX_Tuning_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ("-lstdc++");
   end Linker;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Kind ("Ada") use "spaces";
      for Indentation_Continuation ("Ada") use "2";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;

end CPP_Adapter_Tests;
