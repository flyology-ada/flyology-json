with "../flyology_json.gpr";

project Flyology_JSON_Examples is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/examples";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use
     ("streaming_parser.adb", "transactional_writer.adb", "landing_samples.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa", "-gnato13", "-gnatE", "-gnata", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Format is
      for Width ("Ada") use "110";
      for Indentation ("Ada") use "3";
      for Indentation_Kind ("Ada") use "spaces";
      for Indentation_Continuation ("Ada") use "2";
      for End_Of_Line ("Ada") use "lf";
      for Charset ("Ada") use "utf-8";
   end Format;
end Flyology_JSON_Examples;
