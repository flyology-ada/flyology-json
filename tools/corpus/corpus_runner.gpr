project Corpus_Runner is
   for Source_Dirs use ("../../src", ".");
   for Object_Dir use "../../obj/corpus-runner";
   for Exec_Dir use "../../tests/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("flyology_json-corpus_runner.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa", "-gnato13", "-gnatE", "-gnata", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Corpus_Runner;
