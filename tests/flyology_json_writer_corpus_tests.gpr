project Flyology_JSON_Writer_Corpus_Tests is
   for Source_Dirs use ("../src", ".");
   for Object_Dir use "../obj/writer-corpus-tests";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("flyology_json-writer_corpus_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa", "-gnato13", "-gnatE", "-gnata", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Flyology_JSON_Writer_Corpus_Tests;
